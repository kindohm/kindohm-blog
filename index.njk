---
layout: layout.njk
title: kindohm blog/social
pagination:
  data: collections.posts
  size: 10
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/{% else %}/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<p class="intro">Occasional information and updates.
Otherwise I just post things so I don't forget them.</p>

{% for post in posts %}
  <article class="post-summary">
    <h1><a href="{{ post.url }}">{{ post.data.title }}</a></h1>
    <time datetime="{{ post.date | dateISO }}">{{ post.date | dateDisplay }}</time>
    {{ post.content | absoluteImageUrls(post.url) | safe }}
  </article>
{% endfor %}

{% if pagination.hrefs.length > 1 %}
  <nav class="pagination" aria-label="Post pages">
    {% if pagination.href.previous %}
      <a href="{{ pagination.href.previous }}">previous</a>
    {% else %}
      <span aria-disabled="true">previous</span>
    {% endif %}

    <ol>
      {% for href in pagination.hrefs %}
        <li>
          <a href="{{ href }}"{% if page.url == href %} aria-current="page"{% endif %}>{{ loop.index }}</a>
        </li>
      {% endfor %}
    </ol>

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}">next</a>
    {% else %}
      <span aria-disabled="true">next</span>
    {% endif %}
  </nav>
{% endif %}
